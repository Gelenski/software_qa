# Copie para .env e ajuste conforme o seu ambiente
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=testaudit
DB_NAME=testaudit

# Verificacao de prazos (aviso "perto do vencimento" + escalonamento)
PRAZO_ALERTA_DIAS=2
CRON_VERIFICAR_PRAZOS=0 * * * *
EMAIL_LIDER=lider.qa@empresa.com

# SMTP para envio real de e-mail. Deixe SMTP_HOST em branco para usar o
# modo de teste (loga o e-mail no console em vez de enviar de verdade).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TestAudit <no-reply@testaudit.local>
